# Google Drive - ID folder tujuan upload gambar
# Buka folder di Google Drive → lihat URL → salin ID-nya
# Contoh URL: https://drive.google.com/drive/folders/1ABC123xyz → ID: 1ABC123xyz
DRIVE_FOLDER_ID=your_drive_folder_id_here

# Google Sheets - ID spreadsheet tujuan append pesan
# Buka spreadsheet → lihat URL → salin ID-nya
# Contoh URL: https://docs.google.com/spreadsheets/d/1XYZ456abc/edit → ID: 1XYZ456abc
SPREADSHEET_ID=your_spreadsheet_id_here

# Nama sheet/tab dalam spreadsheet (default: Data)
SHEET_NAME=Data

# WhatsApp Group ID yang akan dipantau
# Format: 628xxxxxxxxx-xxxxxxxxxx@g.us
# Cara dapat: jalankan node index.js, kirim pesan sembarang ke grup, lihat log terminal
TARGET_GROUP_ID=your_group_id_here
